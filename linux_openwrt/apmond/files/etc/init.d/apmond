START=99
STOP=10
USE_PROCD=1

NAME=apmond
PROG=/usr/sbin/apmond

start_service() {
	mkdir -p /tmp/apmond/ap /tmp/apmond/staging /tmp/apmond/last_ts

	# The server role is passive (uhttpd runs /www/cgi-bin/apmon.cgi); only the client role needs a daemon
	[ "$(uci -q get apmond.client.enabled)" = "1" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "apmond"
}

reload_service() {
	stop
	start
}
