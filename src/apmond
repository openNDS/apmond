# CLI
#############################################
show_help() {
	echo "
  Usage: apmond [option] [argument...]

  option: help, -h, --help
	Show this help

  option: version, -v, --version
	Print the version of apmond

  option: status
	Show the apmond configuration and runtime state

  option: show_ap_data [ap_mac_id | all]
	Show the usage data received from access points (on the router / collector)
	With no argument, list the access points that have sent data

  option: read_log [ -f ]
	Displays the apmond log
	If -f is specified, the existing log will be deleted and all subsequent logs will be followed on the display

  option: debuglevel [0 | 1 | 2 | 3]
	With no argument, print the current debuglevel
	With an argument, set the debuglevel (0 = silent, 1 = notice (default), 2 = info, 3 = debug)
	The change is committed immediately and applied by the running daemon on its next loop pass (no restart)

  option: get_ap_data
	Usage: apmond get_ap_data
	Get json format access point data for this node (as mesh11sd get_ap_data; nothing is sent)

  option: send
	Collect and send access point data to the collector ([<ula>::1]) once

  option: detect
	Run router detection once and apply the runtime ULA addresses

  option: cleanup
	Remove the runtime ULA addresses added by apmond

  option: daemon
	Run the daemon (normally started by procd)

  option: write_node_data [user_agent] [query_string]
	Used internally by apmon.cgi (written by the daemon to cgi_dir, default /www/cgi-bin)
"
}

show_ap_data() {
	data_nodes=$(ls "$datadir/apmond_data/" 2>/dev/null | awk '{printf "%s ", $1}')

	if [ "$1" = "all" ]; then

		if [ -z "$data_nodes" ]; then
			exit 0
		fi

		all_first=1

		for data_node in $data_nodes; do
			hex_to_str "$(awk '{printf "%s", $2}'  "$datadir/apmond_data/$data_node" 2>/dev/null)"

			if [ ! -z "$str" ]; then
				str=$(echo -n "$str" | tail -n +2 | head -n -2)

				if [ "$all_first" -eq 1 ]; then
					echo "{"
					echo -n "$str"
					all_first=0
				else
					echo -e -n "\n  },\n$str"
				fi
			fi
		done

		echo -e "\n  }\n}"

	elif [ -z "$1" ]; then
		echo "===================================================================================================================="
		echo " Show access point usage data"
		echo "    Usage: apmond show_ap_data [ap_mac_id]"
		echo "       or: apmond show_ap_data all"
		echo
		echo " If the access point you are looking for is not in the list - it probably has not had any connections yet - try again later."
		echo "===================================================================================================================="

		if [ ! -z "$data_nodes" ]; then
			echo " The following access points have sent usage data:"

			for data_node in $data_nodes; do
				echo "===================================================================================================================="
				echo
				echo "Access point ID (ap_mac_id)	$data_node"
			done

			echo "===================================================================================================================="
		fi

		exit 1

	else
		node=$(echo "$1" | tr -d ':' | tr 'A-F' 'a-f')

		if ! is_hex "$node" || [ "${#node}" -ne 12 ]; then
			echo "Invalid ap_mac_id [ $1 ]"
			exit 1
		fi

		hex_to_str "$(awk '{printf "%s", $2}'  "$datadir/apmond_data/$node" 2>/dev/null)"

		if [ ! -z "$str" ]; then
			echo "$str"
		fi
	fi

	exit 0
}

# json_str <string>: JSON string body (escapes \ and ", strips control characters)
json_str() {
	printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# json_array <indent> <items...>: prints a JSON array body the way jq . does: "[]" if empty, otherwise
# "[", one element per line indented <indent>+2 spaces, and "]" at <indent> (caller prints key and trailing comma)
json_array() {
	local ind="$1" sep="" it
	shift
	if [ "$#" -eq 0 ]; then
		printf '[]'
		return 0
	fi
	printf '['
	for it in "$@"; do
		printf '%s\n%s  "%s"' "$sep" "$ind" "$(json_str "$it")"
		sep=","
	done
	printf '\n%s]' "$ind"
}

# daemon_pid: pid of a running "apmond daemon" (BusyBox: scan /proc)
daemon_pid() {
	local d cmd
	for d in /proc/[0-9]*; do
		[ "${d#/proc/}" = "$$" ] && continue
		# the pid may exit between the glob and the read: the group redirect also silences ash's "can't open"
		cmd=$({ tr '\000' ' ' < "$d/cmdline"; } 2>/dev/null)
		case "$cmd" in
			*apmond\ daemon*) echo "${d#/proc/}"; return 0 ;;
		esac
	done
	return 1
}

# show_status: JSON, same style as node_status in show_ap_data. Never shows the passphrase or the secret (nor apmon_id, derived from it).
show_status() {
	local seed_default="no" b sep pid running="no" running_checksum ifaces="" i addrs a first aps

	[ "$default_seed_in_use" -eq 1 ] && seed_default="yes"
	pid=$(daemon_pid) && running="yes"
	aps=$(ls "$datadir/apmond_data/" 2>/dev/null | wc -l)

	echo "{"
	echo "  \"apmond_status\": {"
	echo "    \"apmond_version\": \"$(json_str "$version")\","
	echo "    \"apmond_protocol\": \"$(json_str "$protocol_version")\","
	# checksum: the running daemon's own hash (written at daemon start); the script's hash when no daemon runs.
	# installed_checksum: sha256 of /usr/sbin/apmond as installed on disk now. They differ after an upgrade without a restart.
	running_checksum="$checksum"
	[ "$running" = "yes" ] && [ -s "$tmpdir/daemon_checksum" ] && { read -r running_checksum < "$tmpdir/daemon_checksum"; } 2>/dev/null
	echo "    \"checksum\": \"$(json_str "$running_checksum")\","
	echo "    \"installed_checksum\": \"$checksum\","
	[ "$running" = "yes" ] && [ "$running_checksum" != "$checksum" ] && echo "    \"checksum_warning\": \"running daemon differs from /usr/sbin/apmond - restart apmond\","
	echo "    \"enabled\": \"$(json_str "$enabled")\","
	echo "    \"daemon_running\": \"$running\","
	echo "    \"daemon_pid\": \"${pid:-none}\","
	echo "    \"interval_seconds\": \"$(json_str "$interval")\","
	echo "    \"debuglevel\": \"$(json_str "$debuglevel")\","
	echo "    \"router_detect\": \"$(json_str "$router_detect")\","
	echo "    \"default_passphrase\": \"$seed_default\","
	[ "$seed_default" = "yes" ] && echo "    \"passphrase_warning\": \"The built-in default passphrase is in use. Make ApmonD more secure by setting option apmon_seed in /etc/config/apmond (the same on every node)\","

	if [ -n "$apmon_seed" ]; then
		get_device_mac
		[ -f "$tmpdir/is_router" ] && . "$tmpdir/is_router"
		load_role
		echo "    \"ula_prefix\": \"$(json_str "$ula_prefix")\","
		echo "    \"ula_subnet\": \"$(json_str "$ula_subnet")\","
		echo "    \"collector\": \"$(json_str "$router_ula")\","
		echo "    \"device\": \"$(json_str "$id_device")\","
		echo "    \"ap_mac_id\": \"$(json_str "$device_mac")\","
		detect_bridges
		echo "    \"bridge_detect\": \"$([ "$bridge_auto" -eq 1 ] && echo auto || echo list)\","
		printf '    "bridges": '
		json_array "    " $bridges
		echo ","
		echo "    \"role\": \"$(json_str "${role:-unknown (daemon not run yet)}")\","
		echo "    \"role_reason\": \"$(json_str "${role_reason:-none}")\","
		echo "    \"node_ula\": \"$(ipv6_canon "$ula_base:$ula_subnet:$(eui64_iid "$device_mac")")\","

		for i in $id_device $bridge_list; do
			case " $ifaces " in *" $i "*) ;; *) ifaces="$ifaces $i" ;; esac
		done
		echo "    \"ula_addresses\": {"
		first=1
		# kernel shows addresses in canonical form (no leading zeros in a group): compare canonical prefixes
		ula_base_c=$(echo "$ula_base" | sed -E 's/(^|:)0+([0-9a-f])/\1\2/g')
		for i in $ifaces; do
			addrs=$(ip -6 addr show dev "$i" 2>/dev/null | awk -v p="$ula_base_c:" '$1=="inet6" && index($2,p)==1 {print $2}')
			[ "$first" -eq 1 ] || echo ","
			first=0
			printf '      "%s": ' "$(json_str "$i")"
			json_array "      " $addrs
		done
		echo
		echo "    },"
	fi

	if [ -f "$tmpdir/last_send" ]; then
		. "$tmpdir/last_send"
		echo "    \"last_send\": {"
		echo "      \"date_time\": \"$(json_str "$last_send")\","
		echo "      \"status\": \"$(json_str "$last_status")\","
		echo "      \"retcode\": \"$(json_str "$last_retcode")\","
		echo "      \"bytes\": \"$(json_str "$last_bytes")\""
		echo "    },"
	fi

	echo "    \"log_mountpoint\": \"$(json_str "$log_mountpoint")\","
	echo "    \"ap_data_dir\": \"$(json_str "$datadir/apmond_data")\","
	[ -n "$datadir_reason" ] && echo "    \"storage_warning\": \"$(json_str "$datadir_reason")\","
	echo "    \"log_file\": \"$(json_str "$logfile")\","
	echo "    \"cgi_dir\": \"$(json_str "$cgi_dir")\","
	if [ -n "$log_disabled_reason" ]; then
		echo "    \"logging\": \"DISABLED: $(json_str "$log_disabled_reason")\","
	else
		echo "    \"logging\": \"enabled\","
	fi
	echo "    \"runtime_dir\": \"$(json_str "$tmpdir")\","
	echo "    \"access_points_with_data\": \"$aps\","
	printf '    "protocol_mismatch_nodes": '
	json_array "    " $(ls "$tmpdir/protocol_mismatch/" 2>/dev/null)
	echo
	echo "  }"
	echo "}"
}

warn_default_seed() {
	[ "$default_seed_in_use" -eq 1 ] || return 0
	# Logged at notice level (shown at the default debuglevel 1 and above)
	for msg in \
		"apmond is using the built-in default passphrase (apmon_seed). Set your own passphrase to make it more secure." \
		"To set it, on every node: uci set apmond.setup.apmon_seed='<your passphrase>'; uci commit apmond; service apmond restart (or edit option apmon_seed in /etc/config/apmond)"; do
		log_notice "$msg"
	done
}

# set_debuglevel: CLI "debuglevel [N]". Unlike mesh11sd the change is committed at once (LuCI compatibility:
# no pending uci change left to be committed later by an unrelated LuCI save)
set_debuglevel() {
	if [ -z "$1" ]; then
		echo "$debuglevel"
		return 0
	fi

	case "$1" in
		0|1|2|3)
			uci set apmond.setup.debuglevel="$1" && uci commit apmond || return 1
			echo "$1"
			;;
		*)
			echo "Invalid debuglevel requested"
			return 1
			;;
	esac
}

# reload_debuglevel: re-read debuglevel from uci at the top of each daemon loop pass, apply it if valid
reload_debuglevel() {
	local new
	new=$(uci -q get apmond.setup.debuglevel 2>/dev/null)

	case "$new" in
		0|1|2|3)
			if [ "$new" != "$debuglevel" ]; then
				debuglevel="$new"
				log_notice "apmond - debuglevel changed to [ $debuglevel ]"
			fi
			;;
	esac
}

daemon_loop_once() {
	get_router_state
	manage_ula
	send_ap_data
}

run_daemon() {
	if [ "$enabled" != "1" ]; then
		log_notice "apmond - disabled (apmond.setup.enabled=0), idle"
		while true; do sleep 3600 & wait $!; done
	fi


	warn_default_seed
	log_datadir
	setup_apmon_cgi
	last_seed_warning=$(date +%s)
	log_notice "apmond $version daemon starting, collector [ $router_ula ], interval [ $interval ]s"
	echo "$checksum" > "$tmpdir/daemon_checksum"
	trap 'cleanup_ula; rm -f "$entrynum_file" "$tmpdir/daemon_checksum"; exit 0' INT TERM
	rm -f "$tmpdir/wifidetect" "$tmpdir/factory_mac" "$tmpdir/apmond/clients.loc" "$tmpdir/role"
	outputfile="$tmpdir/wifidetect"
	wifi_chipset_detect
	get_router_state
	manage_ula
	sleep "$startup_delay" & wait $!

	while true; do
		reload_debuglevel

		if [ "$default_seed_in_use" -eq 1 ] && [ $(( $(date +%s) - last_seed_warning )) -ge "$default_seed_warn_interval" ]; then
			warn_default_seed
			last_seed_warning=$(date +%s)
		fi

		daemon_loop_once
		sleep "$interval" & wait $!
	done
}

##############
# Start point
##############
load_config

# Log entry counter: shared through a file so log calls in $(...) subshells keep it in step.
# The daemon uses $tmpdir/entrynum (reset at start, removed on stop / cleanup); every other invocation
# (CLI, apmon.cgi) has its own per-process file, starting at [1] as before and removed on exit.
if [ "$1" != "daemon" ]; then
	entrynum_file="$tmpdir/entrynum.$$"
	trap 'rm -f "$entrynum_file"' EXIT
fi

case "$1" in
	""|-h|--help|help) show_help;;
	version|-v|--version) echo "apmond version $version";;
	status) show_status;;
	debuglevel) set_debuglevel "$2"; exit $?;;
	show_ap_data) show_ap_data "$2";;
	get_ap_data) get_ap_data; exit 0;;
	send) send_ap_data; exit $?;;
	read_log) read_log "$2";;
	detect) get_router_state; manage_ula; echo "$role";;
	cleanup) cleanup_ula; rm -f "$tmpdir/entrynum" "$tmpdir/daemon_checksum";;
	daemon) entrynum_file="$tmpdir/entrynum"; mkdir -p "$tmpdir"; echo 0 > "$entrynum_file"; run_daemon;;
	write_node_data) write_node_data "$2" "$3"; exit $?;;
	*) echo "Unknown option [ $1 ]"; show_help; exit 1;;
esac
