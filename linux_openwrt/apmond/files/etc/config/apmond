# apmond configuration - use the SAME file on every node (access points and router).
# apmond never writes to this file; edit it by hand, with uci or with LuCI.
#
# The shared secret and the IPv6 ULA prefix are both derived from apmon_seed (sha256), as mesh11sd
# derives its mesh_id and ULA prefix from auto_mesh_id. The router (the node with an upstream wan
# gateway) is detected automatically and becomes the collector at <ula_prefix>:<subnet>::1.
#
# apmon_seed (not set here): a passphrase, identical on every node.
# While it is not set, a built-in default passphrase is used so apmond works out of the box.
# Make ApmonD more secure by setting your own passphrase. apmond logs a notice at start and
# every 6 hours while the default is in use.
# To use your own passphrase, add an apmon_seed option to the setup section (with uci or LuCI)
# on every node, then restart apmond.

config apmond 'setup'
	# Optional - built-in defaults shown
	#option enabled '1'
	#option interval '30'                       # seconds between reports, minimum 10
	#option startup_delay '60'                  # seconds before the first report
	#option device 'br-lan'                     # carries the ULA addresses, its MAC identifies this node
	# On a vlan_filtering bridge the lan VLAN subinterface (network.lan.device, e.g. br-lan.10) is used automatically
	# Wired client bridges: unset or 'auto' (default) = every bridge except the wan/upstream bridge,
	# re-detected each pass (e.g. br-lan and br-guest). List bridge names instead to limit the scan to them.
	#list bridge 'auto'
	#option router_detect '1'                   # 1 auto, 0 force router/collector, 2 force peer
	#option router_takeover_misses '3'          # backed-off router: take over after ::1 misses this many checks
	#option claim_delay_max '10'               # random 0..N s delay before first claiming ::1
	#option log_mountpoint '/tmp'              # AP data in <log_mountpoint>/apmond/apmond_data/<mac>, e.g. '/mnt/usb' (must be mounted)
	                                            # log file: <log_mountpoint>/apmond/apmond_log.log (apmond read_log [-f])
	                                            # runtime state always stays in volatile /var/run/apmond
	#option max_log_entries '500'              # log file is truncated to the last N lines
	#option cgi_dir '/www/cgi-bin'             # where the daemon writes the receiver apmon.cgi at startup (as mesh11sd apmond_cgi_dir)
	                                            # change it only if a web server other than uhttpd serves /cgi-bin/ from another directory
	#option max_age '120'                       # reject reports older/newer than this (seconds)
	#option max_report_size '1048576'           # hex characters
	#option default_seed_warn_interval '21600'  # seconds between default passphrase warnings
	#option debuglevel '1'                      # 0 errors, 1 notices (default), 2 info, 3 debug
	#option verbose_debug '0'                  # 1 = also log full user agent / node id strings at debuglevel 3
